<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>AP-Music - detail</title>
    <link rel="stylesheet" href="/css/reset.css">
    <link rel="stylesheet" href="/css/shared_classes.css">
    <link rel="stylesheet" href="/css/play_bar.css">
    <link rel="stylesheet" href="/css/header.css">

    <link rel="stylesheet" href="/css/detailpage.css">

    <script type="module" defer src="/js/detailspage.js"></script>
</head>

<body>

    <%- include("partials/header") %>

        <main>
            <section>
                <div class="search_for">
                    <input type="text" placeholder="Search for song">
                </div>

                <article id="track_details" track_id="<%= track.id %>" if_liked="<%= if_liked %>">
                    <img src="<%= track.album_cover_medium %>" alt="">

                    <div class="info_line">
                        <h3>Titel: </h3>
                        <h3>
                            <%= track.title %>
                        </h3>
                        <h3>Album: </h3>
                        <h3>
                            <%= track.album_title %>
                        </h3>
                        <h3>Artiesten: </h3>
                        <h3>
                            <%= track.artist %>
                        </h3>
                        <h3>Dansbaarheid: </h3>
                        <h3>
                            <%= track.danceability %>
                        </h3>
                        <h3>Energie: </h3>
                        <h3>
                            <%= track.energy %>
                        </h3>
                        <h3>Tempo: </h3>
                        <h3>
                            <%= track.tempo %>
                        </h3>
                    </div>


                    <div class="options">
                        <button id="like_button">
                            <img src="/assets/icons/heart2.png" alt="">
                        </button>
                        <button>
                            <img src="/assets/icons/info.png" alt="">
                        </button>
                        <button>
                            <img src="/assets/icons/plus-icon.png" alt="">
                        </button>
                    </div>

                </article>
            </section>
        </main>

        <%- include("partials/footer") %>
</body>

</html>