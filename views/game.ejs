<!doctype html>
<html lang="en">

<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>AP-Music</title>
    <link rel="stylesheet" href="./css/reset.css" />
    <link rel="stylesheet" href="./css/general.css" />
    <link rel="stylesheet" href="./css/geuss_game.css">
    <script type="module" src="./js/geuss_game.js" defer></script>
    <script type="module" defer src="./js/generalJava.js"></script>
</head>

<body class="body-home">
    <%- include('partials/header') %>

    <script id="song-data" type="application/json"><%- JSON.stringify(song) %></script>

    <main>
        <section class="guess-content">

            <section class="guess-card">
                <button id="reset-btn" class="reset-badge">Reset</button>
                <div class="score-badge">
                    Mood Score: <span id="current-score">0</span>
                </div>

                <div class="player-visual">
                    <div id="cover-container" class="unknown-art">
                        <span id="cover-question-mark">?</span>
                        <img id="cover-img" src="<%= song.cover %>" alt="album cover" style="display:none;" />
                    </div>

                    <div class="audio-controls">
                        <button id="play-btn" class="play-preview-btn" disabled>
                            <img id="play-icon-img" src="./assets/icons/playIcon.png" alt="Play">
                        </button>
                        <p id="status-text">Raad het nummer op basis van de hoes!</p>
                        <audio id="music-preview"></audio>
                    </div>
                </div>

                <div class="guess-form">
                    <h2>Welk nummer hoor je?</h2>

                    <div class="input-group">
                        <input type="text" id="guess-input" list="song-options"
                            placeholder="Typ titel of artiest...">
                        <datalist id="song-options">
                            <% allSongs.forEach(function(s) { %>
                                <option value="<%= s.artist %> - <%= s.title %>">
                            <% }); %>
                        </datalist>
                    </div>

                    <button id="submit-btn" class="submit-guess-btn">Raad nummer!</button>
                </div>

                <div id="feedback" class="feedback-area hidden"></div>
            </section>
        </section>

    </main>

    <%- include('partials/footer') %>

</body>

</html>