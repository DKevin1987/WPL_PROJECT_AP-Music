<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>AP-Music - Playlist Generator</title>
    <link rel="stylesheet" href="/css/reset.css">
    <link rel="stylesheet" href="/css/general.css">
    <link rel="stylesheet" href="/css/playlist.css">
</head>
<body>

    <%- include('partials/header') %>
    <main>
        <%- include('partials/dropdown') %>
    <section class="musicplayer main-item2">
        <div class="player-container">
            <div class="music-left-logo">
                <img class="music-logo" src="/assets/album-covers/AcDc.png" alt="">
            </div>
            <div class="music-middle-title">
                <h3 class="title-artist">ARTIEST</h3>
                <p>TITEL</p>
            </div>
            <div class="music-middle-player">
                <div class="previous-logo">
                    <button class="player-buttons">
                        <img class="player-logo" src="/assets/icons/previous-track-icon.png" alt="">
                    </button>
                </div>
                <div class="play-logo">
                    <button class="player-buttons">
                        <img class="player-logo" src="/assets/icons/playIcon.png" alt="">
                    </button>
                </div>
                <div class="next-logo">
                    <button class="player-buttons">
                        <img class="player-logo" src="/assets/icons/next-track-icon.png" alt="">
                    </button>
                </div>
            </div>
        </div>
    </section>
            <section class="playlist-container">
        <div>
            <button class="playlistBtn" id="addPlaylist">
                <img id="addIcon" src="/assets/icons/plus-icon.png" alt="">
            </button>
        </div>

        <% allSongs.forEach(function(song) { %>
        <div class="playlist" data-id="<%= song.id %>">
            <button class="playlistBtn">
                <img class="playlistCover" src="<%= song.cover %>" alt="<%= song.title %>">
            </button>
            <div class="playlist-buttons">
                <img class="playlist-icon openPlaylist" src="/assets/icons/info.png" alt="">
                <img class="playlist-icon" src="/assets/icons/removeCross.png" alt="">
            </div>
        </div>
        <% }); %>
    </section>
    <img class="returnArrow hidden" id="arrowBack" src="/assets/icons/arrowBack.png" alt="">

    <section class="music-playlist hidden">
    <% allSongs.forEach(function(song) { %>
        <div class="resultaat" data-id="<%= song.id %>">
            <img class="resultaat-cover" src="<%= song.cover %>" alt="<%= song.title %>">
            <div class="resultaat-tekst">
                <h3 class="Title"><%= song.title %></h3>
                <p class="artiest"><%= song.artist %></p>
            </div>
            <button class="like-btn">
                <img class="like" src="/assets/icons/heart.png" alt="">
            </button>
            <button class="play-btn">
                <img class="play" src="/assets/icons/playIcon.png" alt="">
            </button>
            <button class="remove-btn">
                <img class="remove" src="/assets/icons/removeCross.png" alt="">
            </button>
        </div>
        <% }); %>
    </section>
        
    </main>

    <script src="/js/generalJava.js"></script>
    <script src="/js/playlist.js"></script>
    <%- include('partials/footer') %>

</body>
</html>