<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>AP-Music - Vergelijk</title>
    <link rel="stylesheet" href="/css/reset.css">
    <link rel="stylesheet" href="/css/general.css">
    <link rel="stylesheet" href="./css/vergelijking_pagina.css">
    <link rel="stylesheet" href="./css/like-playlist-notification.css">
    <link rel="stylesheet" href="./css/detail.css">
    <script type="module" src="./js/like-playlist-noyificaction-vergelijkings_pagina.js"></script>
    <script type="module" src="./js/generalJava.js"></script>
</head>
<body>

    <%- include('partials/header') %>

        <main class="vergelijking-content">
        <%- include('partials/dropdown') %>
      
        <section class="musicplayer main-item2">
            <div class="player-container">
                <div class="music-left-logo">
                    <img class="music-logo" src="./assets/album-covers/AcDc.png" alt="">
                </div>
                <div class="music-middle-title">
                    <h3 class="title-artist">AC/DC</h3>
                    <p>Thunderstruck</p>
                </div>
                <div class="music-middle-player">
                    <div class="previous-logo">
                        <button class="player-buttons">
                            <img class="player-logo" src="./assets/icons/previous-track-icon.png" alt="">
                        </button>
                    </div>
                    <div class="play-logo">
                        <button class="player-buttons">
                            <img class="player-logo" src="./assets/icons/play-icon.png" alt="">
                        </button>
                    </div>
                    <div class="next-logo">
                        <button class="player-buttons">
                            <img class="player-logo" src="./assets/icons/next-track-icon.png" alt="">
                        </button>
                    </div>
                </div>
            </div>
        </section>
        <div class="vergelijking-grid">

        <% [song1, song2].forEach(function(song) { %>
        <section class="vergelijking-card">
            <div class="vergelijking-art">
                <img src="<%= song.cover %>" alt="<%= song.title %>">
            </div>
            <div class="vergelijking-text">
                <h2><%= song.title %></h2>
                <p><%= song.artist %></p>
                
                <div id="likediv">
                    <button class="likeButton detailButton likeButtonEmtpy" id="like-<%= song.id %>"></button>
                    <button class="likeButton detailButton likeButtonFull hidden" id="likefull-<%= song.id %>"></button>
                    <button class="detailButton addPlaylistButton playlistButton" id="playlist-<%= song.id %>"></button>
                </div>
            </div>

            <section class="likeSectionMelding">
                <div class="notification likeAddMelding hidden">
                    <h2>Wil je deze toevoegen aan favorieten?</h2>
                    <div>
                        <button class="notificationButton buttonYes">JA</button>
                        <button class="notificationButton buttonNo">NEE</button>
                    </div>
                </div>
                <div class="notification likeDeleteMelding hidden">
                    <h2>Wil je deze verwijderen uit favorieten?</h2>
                    <div>
                        <button class="notificationButton buttonYes">JA</button>
                        <button class="notificationButton buttonNo">NEE</button>
                    </div>
                </div>
                <div class="notification likeToegevoegdBevestiging hidden">
                    <h2>U hebt deze toegevoegd aan favorieten.</h2>
                    <div><button class="likeMeldingButton">OK</button></div>
                </div>
                <div class="notification likeDeleteBevestiging hidden">
                    <h2>U hebt deze verwijderd uit favorieten.</h2>
                    <div><button class="likeMeldingButton">OK</button></div>
                </div>
            </section>

            <section class="addPlaylistSection">
                <div class="addToPlaylistMelding notification hidden">
                    <h2>Aan welke playlist wil je deze toevoegen?</h2>
                    <div class="playlistadder">
                        <p>PLAYLIST-NAAM</p>
                        <button class="notificationButton buttonYes">JA</button>
                    </div>
                    <div><button class="notificationButton buttonNo">NEE</button></div>
                </div>
                <div class="addPlaylistBevestiging notification hidden">
                    <h2>U hebt deze toegevoegd aan de playlist.</h2>
                    <div><button class="likeMeldingButton">OK</button></div>
                </div>
            </section>
        </section>
        <% }); %>
        </div>
            <div class="NieuweVergelijking">
            <a href="/vergelijk" class="btn"> Nieuwe vergelijking</a>
            </div>
    </main>
    <%- include('partials/footer') %>

</body>
</html>